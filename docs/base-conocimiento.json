      "prioridad": 2
    },
    {
      "id": "REC-DEPENDENCIAS",
      "titulo": "Acordar interfaces y fechas con los proveedores externos",
      "accion": "Contrato de interfaz por escrito y fecha de disponibilidad confirmada. Además, definí qué hace el equipo si la dependencia no llega.",
      "categoria": "tecnico",
      "prioridad": 1
    },
    {

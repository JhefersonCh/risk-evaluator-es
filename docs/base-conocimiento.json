  "recomendaciones": [
    {
      "id": "REC-GESTION-CAMBIOS",
      "titulo": "Abrir un proceso formal de gestión de cambios",
      "accion": "Toda solicitud nueva entra por un único canal, se estima y se aprueba antes de tocar el plan. Sin ese paso, el alcance crece sin que nadie lo mida.",
      "categoria": "requisitos",
      "prioridad": 1
    },
    {
      "id": "REC-BASELINE-REQ",
      "titulo": "Congelar una línea base de requisitos por iteración",
      "accion": "Fijá el alcance de cada iteración al empezarla. Lo que llegue después entra en la siguiente, no en la actual.",
      "categoria": "requisitos",
      "prioridad": 2
    },
    {
      "id": "REC-DOC-REQ",
      "titulo": "Escribir criterios de aceptación verificables",
      "accion": "Cada requisito necesita una condición que se pueda probar. Un requisito que no se puede verificar no se puede dar por terminado.",
      "categoria": "requisitos",
      "prioridad": 2
    },
    {
      "id": "REC-ALCANCE",
      "titulo": "Definir un alcance mínimo entregable",
      "accion": "Separá lo imprescindible de lo deseable y comprometé sólo lo primero. El resto queda como candidato para versiones siguientes.",
      "categoria": "requisitos",
      "prioridad": 1
    },
    {
      "id": "REC-COBERTURA",
      "titulo": "Cubrir con pruebas los flujos críticos",
      "accion": "Identificá los tres o cuatro recorridos que no pueden fallar y escribí pruebas para ellos antes de sumar funcionalidad nueva.",
      "categoria": "calidad",
      "prioridad": 1
    },
    {
      "id": "REC-AUTOMATIZAR",
      "titulo": "Automatizar las pruebas repetitivas",
      "accion": "Lo que se prueba a mano en cada entrega es lo primero que se deja de probar cuando aprieta el tiempo. Automatizalo.",
      "categoria": "calidad",
      "prioridad": 2
    },
    {
      "id": "REC-DEFINICION-HECHO",
      "titulo": "Acordar una definición de terminado",
      "accion": "Una tarea está terminada cuando pasa sus pruebas, está revisada e integrada. Escribilo y aplicalo sin excepciones.",
      "categoria": "calidad",
      "prioridad": 2
    },
    {
      "id": "REC-CI",
      "titulo": "Montar integración continua",
      "accion": "Compilá y ejecutá las pruebas en cada cambio subido. Un fallo detectado en minutos cuesta una fracción de uno detectado en la entrega.",
      "categoria": "tecnico",
      "prioridad": 1
    },
    {
      "id": "REC-VCS",
      "titulo": "Adoptar un flujo de ramas con revisión obligatoria",
      "accion": "Rama por cambio, revisión antes de integrar, historial legible. Sin esto no hay forma de volver atrás con confianza.",
      "categoria": "tecnico",
      "prioridad": 1
    },
    {
      "id": "REC-VCS-BASICO",
      "titulo": "Unificar el uso del control de versiones",
      "accion": "Todo el equipo, el mismo flujo, el mismo repositorio. Las prácticas parciales generan la falsa sensación de estar cubiertos.",
      "categoria": "tecnico",
      "prioridad": 2
    },
    {
      "id": "REC-INTEGRACION-TEMPRANA",
      "titulo": "Integrar temprano y seguido",
      "accion": "Juntá el trabajo de todos varias veces por semana. Cuanto más tarde se integra, más caro sale el conflicto.",
      "categoria": "tecnico",
      "prioridad": 1
    },
    {
      "id": "REC-MENTORIA",
      "titulo": "Emparejar a quienes tienen menos experiencia",
      "accion": "Asigná mentoría y revisión por pares en las áreas sensibles. La experiencia se transfiere trabajando, no leyendo documentación.",
      "categoria": "equipo",
      "prioridad": 1
    },
    {
      "id": "REC-SUBEQUIPOS",
      "titulo": "Dividir el equipo en células con responsable técnico",
      "accion": "Grupos de cuatro a seis personas con un referente por área. Un equipo grande sin estructura gasta más en coordinarse que en construir.",
      "categoria": "gestion",
      "prioridad": 1
    },
    {
      "id": "REC-DOC-CONOCIMIENTO",
      "titulo": "Documentar decisiones y rotar responsabilidades",
